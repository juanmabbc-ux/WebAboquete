---
import { Image } from 'astro:assets';
import logo from '../assets/brand/brand_logo.png';
import { site, whatsappUrl } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (path: string) => currentPath === path;
---

<header class="sticky top-0 z-40 backdrop-blur bg-white/85 border-b border-[var(--color-border)]">
  <div class="container-x flex items-center justify-between h-16 sm:h-20">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.legalName} — Inicio`}>
      <Image
        src={logo}
        alt={`${site.legalName} ${site.tagline}`}
        widths={[120, 180, 240]}
        sizes="(min-width: 768px) 180px, 140px"
        loading="eager"
        class="h-9 sm:h-11 w-auto"
      />
    </a>

    <nav aria-label="Navegación principal" class="hidden md:flex items-center gap-1">
      <a
        href="/"
        class:list={[
          'px-4 py-2 text-sm font-medium rounded-full transition-colors',
          isActive('/') ? 'text-[var(--color-bosque-700)] bg-[var(--color-bosque-50)]' : 'text-[var(--color-text)] hover:text-[var(--color-bosque-700)] hover:bg-[var(--color-bosque-50)]',
        ]}
        aria-current={isActive('/') ? 'page' : undefined}
      >
        Inicio
      </a>
      <a
        href="/productos"
        class:list={[
          'px-4 py-2 text-sm font-medium rounded-full transition-colors',
          isActive('/productos') ? 'text-[var(--color-bosque-700)] bg-[var(--color-bosque-50)]' : 'text-[var(--color-text)] hover:text-[var(--color-bosque-700)] hover:bg-[var(--color-bosque-50)]',
        ]}
        aria-current={isActive('/productos') ? 'page' : undefined}
      >
        Productos
      </a>
      <a
        href="/vivero"
        class:list={[
          'px-4 py-2 text-sm font-medium rounded-full transition-colors',
          isActive('/vivero') ? 'text-[var(--color-bosque-700)] bg-[var(--color-bosque-50)]' : 'text-[var(--color-text)] hover:text-[var(--color-bosque-700)] hover:bg-[var(--color-bosque-50)]',
        ]}
        aria-current={isActive('/vivero') ? 'page' : undefined}
      >
        Vivero
      </a>
      <a
        href="/#contacto"
        class="px-4 py-2 text-sm font-medium rounded-full text-[var(--color-text)] hover:text-[var(--color-bosque-700)] hover:bg-[var(--color-bosque-50)] transition-colors"
      >
        Contacto
      </a>
    </nav>

    <a
      href={whatsappUrl()}
      target="_blank"
      rel="noopener"
      class="btn btn-primary text-sm hidden sm:inline-flex"
      aria-label="Cotizar por WhatsApp"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.224-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.521.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.71.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347Z M20.52 3.449C18.24 1.21 15.21 0 12.05 0 5.495 0 .16 5.336.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.687 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.85 11.85 0 0 0-3.428-8.452Zm-8.469 18.292h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.999-3.648-.235-.374a9.86 9.86 0 0 1-1.511-5.27c.002-5.45 4.437-9.884 9.889-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.886 9.885Z"/>
      </svg>
      Cotizar por WhatsApp
    </a>

    <button
      id="mobileMenuBtn"
      class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-full text-[var(--color-bosque-700)] hover:bg-[var(--color-bosque-50)]"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"/>
      </svg>
    </button>
  </div>

  <div
    id="mobileMenu"
    class="md:hidden hidden border-t border-[var(--color-border)] bg-white"
  >
    <nav aria-label="Navegación principal móvil" class="container-x py-4 flex flex-col gap-1">
      <a href="/" class="px-4 py-3 rounded-md text-base font-medium hover:bg-[var(--color-bosque-50)]">Inicio</a>
      <a href="/productos" class="px-4 py-3 rounded-md text-base font-medium hover:bg-[var(--color-bosque-50)]">Productos</a>
      <a href="/vivero" class="px-4 py-3 rounded-md text-base font-medium hover:bg-[var(--color-bosque-50)]">Vivero</a>
      <a href="/#contacto" class="px-4 py-3 rounded-md text-base font-medium hover:bg-[var(--color-bosque-50)]">Contacto</a>
      <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-primary mt-3 w-full">
        Cotizar por WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');
  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });
</script>
