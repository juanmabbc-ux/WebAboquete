---
import Icon from './Icon.astro';
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-[var(--color-border)] rounded-2xl border border-[var(--color-border)] bg-white overflow-hidden">
  {items.map((item, i) => (
    <details class="group">
      <summary class="cursor-pointer list-none flex items-start gap-4 p-5 sm:p-6 hover:bg-[var(--color-crema)] transition-colors">
        <span class="flex-1 text-base sm:text-lg font-semibold text-[var(--color-bosque-700)]">
          {item.q}
        </span>
        <span class="shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-full bg-[var(--color-bosque-50)] text-[var(--color-bosque-700)] transition-transform duration-200 group-open:rotate-180">
          <Icon name="chevron-down" size={18} />
        </span>
      </summary>
      <div class="px-5 sm:px-6 pb-6 -mt-1 text-[var(--color-text-muted)] leading-relaxed text-[15px]">
        {item.a}
      </div>
    </details>
  ))}
</div>
