---
import { Image } from 'astro:assets';
import { whatsappUrl } from '../data/site';
import type { PackagedProduct } from '../data/products';

interface Props {
  product: PackagedProduct;
  /** Compact = used on homepage preview (no composition / shorter) */
  compact?: boolean;
}

const { product, compact = false } = Astro.props;
const msg = `Hola Aboquete, quisiera cotizar ${product.name}. ¿Me pueden dar precio y disponibilidad?`;
---

<article class="card overflow-hidden flex flex-col h-full" id={`producto-${product.slug}`}>
  <div class="aspect-[4/3] overflow-hidden bg-white flex items-center justify-center border-b border-[var(--color-border)]">
    <Image
      src={product.image}
      alt={`${product.name} Aboquete — ${product.tagline}`}
      widths={[400, 600, 800]}
      sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
      loading="lazy"
      class="w-full h-full object-contain p-4"
    />
  </div>

  <div class="p-6 flex flex-col gap-3 flex-1">
    <div>
      <h3 class="text-xl font-semibold leading-tight">{product.name}</h3>
      <p class="mt-1 text-sm text-[var(--color-text-muted)]">{product.tagline}</p>
    </div>

    <p class="text-sm leading-relaxed">
      {compact ? product.description : product.definition}
    </p>

    {!compact && product.composition && (
      <dl class="grid grid-cols-2 gap-x-3 gap-y-1.5 mt-1 rounded-lg bg-[var(--color-crema)] p-3 text-xs">
        {product.composition.map((c) => (
          <div class="flex justify-between gap-2">
            <dt class="text-[var(--color-text-muted)]">{c.label}</dt>
            <dd class="font-semibold text-[var(--color-bosque-700)]">{c.value}</dd>
          </div>
        ))}
      </dl>
    )}

    {!compact && (
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)] mb-1.5">
          Usos principales
        </p>
        <ul class="flex flex-wrap gap-1.5">
          {product.uses.map((u) => (
            <li class="pill">{u}</li>
          ))}
        </ul>
      </div>
    )}

    <div class="mt-auto pt-3">
      <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)] mb-2">
        Presentaciones
      </p>
      <ul class="flex flex-wrap gap-2 mb-4">
        {product.presentations.map((p) => (
          <li class="inline-flex items-baseline gap-1 rounded-md border border-[var(--color-border)] bg-white px-2.5 py-1 text-xs">
            <span class="font-semibold">{p.size}</span>
            {p.weight && <span class="text-[var(--color-text-muted)]">· {p.weight}</span>}
          </li>
        ))}
      </ul>

      <a
        href={whatsappUrl(msg)}
        target="_blank"
        rel="noopener"
        class="btn btn-primary w-full"
        aria-label={`Cotizar ${product.name} por WhatsApp`}
      >
        Cotizar por WhatsApp
      </a>
    </div>
  </div>
</article>
