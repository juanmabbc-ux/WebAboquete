---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import { site, whatsappUrl } from '../data/site';
import { packaged, featuredSlugs } from '../data/products';
import { plants } from '../data/vivero';
import logoSymbol from '../assets/brand/logo.jpg';

const featured = packaged.filter((p) => featuredSlugs.includes(p.slug));

const title = `${site.legalName} — El Aliado de tu Proyecto de Jardinería y Paisajismo en Panamá | ${site.tagline}`;
const description =
  'Todo para tu proyecto de jardinería y paisajismo, de un solo proveedor: tierra negra, abono orgánico, sustratos, mezclas personalizadas y plantas de vivero. Cualquier cantidad, del saco al volquete, con entrega en todo Panamá.';
---

<BaseLayout title={title} description={description}>

  <!-- ============ HERO ============ -->
  <section class="relative bg-campo pt-12 sm:pt-20 pb-20 sm:pb-28 overflow-hidden">
    <div class="container-x grid lg:grid-cols-[1.1fr,0.9fr] gap-12 items-center relative z-10">
      <div>
        <span class="eyebrow">
          <span class="w-2 h-2 rounded-full bg-[var(--color-naranja-400)]"></span>
          Proveedor mayorista · Desde el año 2000
        </span>
        <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl leading-[1.05]">
          El aliado de tu proyecto de<br />
          <span class="text-[var(--color-naranja-400)]">jardinería y paisajismo.</span>
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-[var(--color-text-muted)] max-w-xl">
          Todo lo que tu proyecto necesita, de un solo proveedor: tierra negra, abono orgánico,
          sustratos, mezclas personalizadas y plantas de vivero — en cualquier cantidad, del saco
          al volquete, con entrega en todo Panamá.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={whatsappUrl('Hola Aboquete, quisiera una propuesta comercial para mi negocio o proyecto. ¿Pueden ayudarme?')} target="_blank" rel="noopener" class="btn btn-primary text-base">
            Solicitar propuesta comercial
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="/productos" class="btn btn-outline text-base">
            Ver líneas de producto
          </a>
        </div>

        <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-[var(--color-text-muted)]">
          <li class="inline-flex items-center gap-2">
            <Icon name="check" size={16} class="text-[var(--color-lima-400)]" />
            Volquetes y pallets
          </li>
          <li class="inline-flex items-center gap-2">
            <Icon name="check" size={16} class="text-[var(--color-lima-400)]" />
            Exportación FOB Panamá
          </li>
          <li class="inline-flex items-center gap-2">
            <Icon name="check" size={16} class="text-[var(--color-lima-400)]" />
            Entrega a nivel nacional
          </li>
          <li class="inline-flex items-center gap-2">
            <Icon name="check" size={16} class="text-[var(--color-lima-400)]" />
            También en presentación empacada
          </li>
        </ul>
      </div>

      <div class="relative aspect-square max-w-md mx-auto w-full">
        <div class="absolute inset-0 rounded-full bg-gradient-to-br from-[var(--color-sol-100)] via-[var(--color-lima-100)] to-[var(--color-bosque-50)] blur-3xl opacity-70"></div>
        <Image
          src={logoSymbol}
          alt="Aboquete — emblema sol sobre campos verdes"
          widths={[400, 600]}
          sizes="(min-width: 1024px) 400px, 320px"
          loading="eager"
          class="relative w-full h-full object-contain drop-shadow-2xl"
        />
      </div>
    </div>
  </section>

  <!-- ============ CREDENCIALES (Trust Strip) ============ -->
  <section class="py-12 sm:py-16 bg-[var(--color-crema)] border-y border-[var(--color-border)]">
    <div class="container-x">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-bosque-700)]">
        Un solo proveedor para todo tu proyecto
      </p>
      <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-6">
        <div class="text-center">
          <p class="text-4xl sm:text-5xl font-display font-semibold text-[var(--color-bosque-700)]">25+</p>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">años en agroindustria</p>
        </div>
        <div class="text-center">
          <p class="text-base sm:text-lg font-semibold text-[var(--color-bosque-700)]">Suelo + plantas</p>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">tierra, sustratos y vivero juntos</p>
        </div>
        <div class="text-center">
          <p class="text-base sm:text-lg font-semibold text-[var(--color-bosque-700)]">Cualquier cantidad</p>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">del saco a la flota de volquetes</p>
        </div>
        <div class="text-center">
          <p class="text-base sm:text-lg font-semibold text-[var(--color-bosque-700)]">Entrega nacional</p>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">a cualquier punto de Panamá</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ A GRANEL (CTA) ============ -->
  <section class="py-20 sm:py-24 bg-[var(--color-bosque-700)] text-white relative overflow-hidden">
    <div class="container-x grid lg:grid-cols-[1.2fr,1fr] gap-10 items-center relative z-10">
      <div>
        <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-sol-300)]">
          <Icon name="truck" size={16}/>
          Pedidos por volquete
        </span>
        <h2 class="mt-3 text-3xl sm:text-4xl text-white">Cualquier cantidad. Cualquier mezcla.</h2>
        <p class="mt-4 text-white/90 leading-relaxed max-w-xl">
          Volquetes a granel, sacos de 100 lbs, pallets de exportación y <strong class="text-white">mezclas de
          tierra personalizadas</strong> — para césped, siembra de árboles o la especificación exacta de tu
          proyecto. Cotizamos por volumen y zona de entrega en todo Panamá.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={whatsappUrl('Hola Aboquete, necesito una cotización por volquete. ¿Pueden ayudarme?')} target="_blank" rel="noopener" class="btn btn-primary">
            Cotizar por volquete
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="/productos#granel" class="btn btn-outline text-white border-white/40 hover:bg-white hover:text-[var(--color-bosque-700)]">
            Ver productos a granel
          </a>
        </div>
      </div>
      <div class="grid gap-3">
        <div class="rounded-xl bg-white/5 border border-white/10 p-5">
          <p class="text-sm text-white/60">Sin mínimos ni máximos</p>
          <p class="mt-1 text-xl font-display font-semibold text-white">Del saco a la flota de volquetes</p>
          <p class="mt-2 text-sm text-white/70">Entregamos la cantidad que tu operación necesite</p>
        </div>
        <div class="rounded-xl bg-white/5 border border-white/10 p-5">
          <p class="text-sm text-white/60">Pallet de exportación</p>
          <p class="mt-1 text-xl font-display font-semibold text-white">25 sacos · ~1.13 t</p>
          <p class="mt-2 text-sm text-white/70">Saco de 100 lbs · Entrega FOB Panamá</p>
        </div>
        <div class="rounded-xl bg-white/5 border border-white/10 p-5">
          <p class="text-sm text-white/60">Mezclas personalizadas</p>
          <p class="mt-1 text-xl font-display font-semibold text-white">Tierra a tu especificación</p>
          <p class="mt-2 text-sm text-white/70">Césped · Siembra de árboles · Paisajismo · Tu fórmula</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROPUESTA DE VALOR (4 pilares) ============ -->
  <section class="py-20 sm:py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow">Por qué Aboquete</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Cuatro razones para confiar en cada saco.</h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="card p-6">
          <span class="inline-flex w-12 h-12 rounded-xl items-center justify-center bg-[var(--color-lima-100)] text-[var(--color-bosque-700)]">
            <Icon name="leaf" size={26} />
          </span>
          <h3 class="mt-5 text-lg">100% Orgánico</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">
            Sin químicos sintéticos ni hormonas. Caballaza compostada y materias primas naturales — eso es todo.
          </p>
        </div>

        <div class="card p-6">
          <span class="inline-flex w-12 h-12 rounded-xl items-center justify-center bg-[var(--color-sol-100)] text-[var(--color-bosque-700)]">
            <Icon name="map-pin" size={26} />
          </span>
          <h3 class="mt-5 text-lg">Producción Panameña</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">
            Origen en Chiriquí, operaciones en Ciudad de Panamá. Materias primas de productores locales.
          </p>
        </div>

        <div class="card p-6">
          <span class="inline-flex w-12 h-12 rounded-xl items-center justify-center bg-[var(--color-naranja-100)] text-[var(--color-bosque-700)]">
            <Icon name="shield-check" size={26} />
          </span>
          <h3 class="mt-5 text-lg">Proyecto Completo</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">
            Tierra, abono, sustratos y plantas de vivero en una sola cotización y una sola entrega.
          </p>
        </div>

        <div class="card p-6">
          <span class="inline-flex w-12 h-12 rounded-xl items-center justify-center bg-[var(--color-bosque-50)] text-[var(--color-bosque-700)]">
            <Icon name="recycle" size={26} />
          </span>
          <h3 class="mt-5 text-lg">Agricultura Regenerativa</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">
            Mejora la salud del suelo, aumenta biodiversidad y contribuye al secuestro de carbono.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MATERIA PRIMA ESTRELLA — CABALLAZA ============ -->
  <section class="py-20 sm:py-24 bg-[var(--color-bosque-900)] text-white">
    <div class="container-x grid lg:grid-cols-2 gap-14 items-center">
      <div>
        <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-sol-300)]">
          <span class="w-2 h-2 rounded-full bg-[var(--color-sol-400)]"></span>
          Materia prima estrella
        </span>
        <h2 class="mt-3 text-3xl sm:text-4xl text-white">
          La caballaza compostada.<br />
          <span class="text-[var(--color-sol-300)]">El corazón de cada producto.</span>
        </h2>
        <p class="mt-5 text-white/85 leading-relaxed">
          Estiércol de caballo procesado por compostaje hasta convertirse en un fertilizante orgánico
          estable, rico y vivo. Esta es la base de nuestro abono, nuestra tierra negra preparada y
          nuestra enmienda agrícola — y la razón por la que el suelo donde la usas vuelve a producir.
        </p>

        <ul class="mt-8 grid gap-3">
          <li class="flex gap-3"><span class="text-[var(--color-sol-300)] mt-1"><Icon name="check" size={18}/></span><span>Mejora la <strong>estructura del suelo</strong>: aireación y retención de humedad.</span></li>
          <li class="flex gap-3"><span class="text-[var(--color-sol-300)] mt-1"><Icon name="check" size={18}/></span><span>Aporta <strong>materia orgánica</strong> e incrementa la actividad biológica.</span></li>
          <li class="flex gap-3"><span class="text-[var(--color-sol-300)] mt-1"><Icon name="check" size={18}/></span><span>Favorece el <strong>desarrollo radicular</strong> desde el primer día.</span></li>
          <li class="flex gap-3"><span class="text-[var(--color-sol-300)] mt-1"><Icon name="check" size={18}/></span><span>Enriquece con <strong>nitrógeno, fósforo y potasio</strong> en forma orgánica.</span></li>
        </ul>
      </div>

      <div class="grid grid-cols-2 gap-4">
        {[
          { label: 'Materia Orgánica', value: '40.75%' },
          { label: 'Nitrógeno (N)', value: '2.37%' },
          { label: 'Fósforo (P₂O₅)', value: '3.12%' },
          { label: 'Calcio (Ca)', value: '2.87%' },
        ].map((s) => (
          <div class="rounded-2xl bg-white/5 border border-white/10 p-6">
            <p class="text-xs uppercase tracking-wider text-white/60">{s.label}</p>
            <p class="mt-2 text-3xl font-display font-semibold text-[var(--color-sol-300)]">{s.value}</p>
          </div>
        ))}
        <p class="col-span-2 text-xs text-white/60 leading-relaxed">
          Composición típica del Abono Orgánico Aboquete. Datos verificados — respaldo
          SENACYT-CECOM y Registro MIDA #{site.midaRegistro}.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ AUDIENCIAS ============ -->
  <section class="py-20 sm:py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow">A quién abastecemos</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Socios de suministro, no ventas de una vez.</h2>
        <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">
          Trabajamos con productores agrícolas que mueven volquetes, constructoras con cronogramas
          que cumplir, viveros que necesitan consistencia y cadenas que buscan un proveedor confiable
          — y también atendemos al detal.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {[
          { icon: 'tractor', title: 'Productores agrícolas', text: 'Fincas, cultivos comerciales y reforestación a gran escala.' },
          { icon: 'sprout', title: 'Viveros', text: 'Sustratos consistentes para producción de plantas en serie.' },
          { icon: 'building', title: 'Constructoras', text: 'Tierra para áreas verdes, jardines y proyectos de paisajismo.' },
          { icon: 'shopping-bag', title: 'Cadenas comerciales', text: 'Producto empacado y marca privada para retail.' },
          { icon: 'home', title: 'Hogares', text: 'Bolsas listas para macetas, huertos y jardines caseros.' },
        ].map((a) => (
          <div class="card p-6 text-center">
            <span class="inline-flex w-14 h-14 rounded-2xl items-center justify-center bg-[var(--color-bosque-50)] text-[var(--color-bosque-700)] mx-auto">
              <Icon name={a.icon as any} size={26} />
            </span>
            <h3 class="mt-4 text-base">{a.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-muted)]">{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PRODUCTOS DESTACADOS ============ -->
  <section class="py-20 sm:py-24">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
        <div class="max-w-xl">
          <span class="eyebrow">Línea empacada</span>
          <h2 class="mt-3 text-3xl sm:text-4xl">Empacado para tu anaquel.</h2>
          <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">
            Presentaciones listas para cadenas, comercios y agroservicios — con composición
            certificada en cada saco. También disponibles al detal para hogar y jardín.
          </p>
        </div>
        <a href="/productos" class="btn btn-outline">
          Ver todos los productos
          <Icon name="arrow-right" size={18} />
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((p) => <ProductCard product={p} compact />)}
      </div>
    </div>
  </section>

  <!-- ============ VIVERO (TEASER) ============ -->
  <section class="py-20 sm:py-24 bg-[var(--color-crema)] border-y border-[var(--color-border)]">
    <div class="container-x grid lg:grid-cols-[1.1fr,1fr] gap-12 items-center">
      <div>
        <span class="eyebrow">Nuevo · Vivero Aboquete</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Plantas para tu proyecto.</h2>
        <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed max-w-xl">
          Ornamentales, palmas, árboles, setos y cobertoras — cultivadas en nuestros propios
          sustratos orgánicos. Abastecemos paisajismo, constructoras y urbanizaciones con
          entrega a nivel nacional.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/vivero" class="btn btn-primary">
            Conocer el vivero
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-3">
        {plants.slice(0, 6).map((p) => (
          <a href={`/vivero#planta-${p.slug}`} class="block aspect-square overflow-hidden rounded-xl border border-[var(--color-border)] bg-white" aria-label={`Ver ${p.name} en el vivero`}>
            <Image
              src={p.image}
              alt={`${p.name} — Vivero Aboquete`}
              widths={[200, 300]}
              sizes="(min-width: 1024px) 160px, 30vw"
              loading="lazy"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA FINAL / CONTACTO ============ -->
  <section class="py-20 sm:py-24">
    <div class="container-x">
      <div class="card p-8 sm:p-12 text-center bg-gradient-to-br from-[var(--color-crema)] to-white">
        <h2 class="text-3xl sm:text-4xl">Hablemos de tu suministro.</h2>
        <p class="mt-4 text-[var(--color-text-muted)] max-w-xl mx-auto leading-relaxed">
          Cuéntanos qué mueve tu operación — volquetes para la finca, pallets para exportar,
          producto empacado para tu anaquel o plantas para tu proyecto. Te respondemos por
          WhatsApp en horario laboral.
        </p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-primary">
            <Icon name="phone" size={18} />
            WhatsApp {site.phoneDisplay}
          </a>
          <a href={`mailto:${site.email}`} class="btn btn-outline">
            <Icon name="mail" size={18} />
            {site.email}
          </a>
        </div>
        <div class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-[var(--color-text-muted)]">
          <span class="inline-flex items-center gap-2">
            <Icon name="map-pin" size={16} class="text-[var(--color-bosque-700)]" />
            {site.address.street}, {site.address.city}
          </span>
          <a href={site.social.instagram} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-[var(--color-bosque-700)]">
            <Icon name="instagram" size={16} class="text-[var(--color-bosque-700)]" />
            Instagram {site.social.instagramHandle}
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
