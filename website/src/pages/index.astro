---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { site, whatsappUrl } from '../data/site';
import granelImg from '../assets/products/volquete.jpg';
import empacadoImg from '../assets/products/saco_abono_100.jpg';
import viveroImg from '../assets/vivero/clusia.jpg';

const title = `${site.legalName} — El Aliado de tu Proyecto de Jardinería y Paisajismo en Panamá | ${site.tagline}`;
const description =
  'Todo para tu proyecto de jardinería y paisajismo, de un solo proveedor: tierra negra, abono orgánico, sustratos, mezclas personalizadas y plantas de vivero. Cualquier cantidad, del saco al volquete, con entrega en todo Panamá.';

const doors = [
  {
    href: '/productos#granel',
    image: granelImg,
    eyebrow: 'Mayoreo y proyectos',
    title: 'Tierra y abono a granel',
    text: 'Volquetes, sacos de 100 lbs y mezclas personalizadas — césped, siembra de árboles o tu fórmula.',
    cta: 'Ver línea a granel',
  },
  {
    href: '/productos#empacados',
    image: empacadoImg,
    eyebrow: 'Cadenas, comercios y hogar',
    title: 'Productos empacados',
    text: 'Abono orgánico, tierra negra, humus de lombriz y sustratos con composición certificada.',
    cta: 'Ver empacados',
  },
  {
    href: '/vivero',
    image: viveroImg,
    eyebrow: 'Paisajismo y jardinería',
    title: 'Plantas de vivero',
    text: 'Ornamentales, palmas, árboles, setos y cobertoras — cultivadas en nuestros propios sustratos.',
    cta: 'Conocer el vivero',
  },
];
---

<BaseLayout title={title} description={description}>

  <!-- ============ HERO ============ -->
  <section class="relative bg-campo pt-12 sm:pt-20 pb-16 sm:pb-20 overflow-hidden">
    <div class="container-x relative z-10">
      <div class="max-w-3xl">
        <span class="eyebrow">
          <span class="w-2 h-2 rounded-full bg-[var(--color-naranja-400)]"></span>
          Proveedor mayorista · Desde el año 2000
        </span>
        <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl leading-[1.05]">
          El aliado de tu proyecto de<br />
          <span class="text-[var(--color-naranja-400)]">jardinería y paisajismo.</span>
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-[var(--color-text-muted)] max-w-xl">
          Todo lo que tu proyecto necesita, de un solo proveedor: tierra negra, abono orgánico,
          sustratos, mezclas personalizadas y plantas de vivero — en cualquier cantidad, del saco
          al volquete, con entrega en todo Panamá.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={whatsappUrl('Hola Aboquete, quisiera una propuesta comercial para mi negocio o proyecto. ¿Pueden ayudarme?')} target="_blank" rel="noopener" class="btn btn-primary text-base">
            Solicitar propuesta comercial
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="#lineas" class="btn btn-outline text-base">
            Ver qué ofrecemos
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LAS 3 PUERTAS ============ -->
  <section id="lineas" class="py-16 sm:py-20 scroll-mt-20">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="eyebrow">Nuestras líneas</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">¿Qué necesita tu proyecto?</h2>
        <p class="mt-4 text-[var(--color-text-muted)] leading-relaxed">
          Tres líneas, un solo proveedor. Elige por dónde empezar — y si lo quieres todo junto,
          lo cotizamos en una sola entrega.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {doors.map((d) => (
          <a href={d.href} class="card overflow-hidden flex flex-col group">
            <div class="aspect-[4/3] overflow-hidden bg-[var(--color-crema)]">
              <Image
                src={d.image}
                alt={d.title}
                widths={[400, 600, 800]}
                sizes="(min-width: 768px) 33vw, 100vw"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <div class="p-6 flex flex-col gap-2 flex-1">
              <span class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-naranja-400)]">{d.eyebrow}</span>
              <h3 class="text-xl font-semibold">{d.title}</h3>
              <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{d.text}</p>
              <span class="mt-auto pt-3 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-bosque-700)] group-hover:gap-3 transition-all">
                {d.cta}
                <Icon name="arrow-right" size={16} />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CREDENCIALES (Trust Strip) ============ -->
  <section class="py-12 sm:py-16 bg-[var(--color-crema)] border-y border-[var(--color-border)]">
    <div class="container-x">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-bosque-700)]">
        Un solo proveedor para todo tu proyecto
      </p>
      <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-6">
        <div class="text-center">
          <p class="text-4xl sm:text-5xl font-display font-semibold text-[var(--color-bosque-700)]">25+</p>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">años en agroindustria</p>
        </div>
        <div class="text-center">
          <p class="text-base sm:text-lg font-semibold text-[var(--color-bosque-700)]">Suelo + plantas</p>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">tierra, sustratos y vivero juntos</p>
        </div>
        <div class="text-center">
          <p class="text-base sm:text-lg font-semibold text-[var(--color-bosque-700)]">Cualquier cantidad</p>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">del saco a la flota de volquetes</p>
        </div>
        <div class="text-center">
          <p class="text-base sm:text-lg font-semibold text-[var(--color-bosque-700)]">Entrega nacional</p>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">a cualquier punto de Panamá</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ POR QUÉ ABOQUETE ============ -->
  <section class="py-16 sm:py-20">
    <div class="container-x">
      <div class="max-w-2xl">
        <span class="eyebrow">Por qué Aboquete</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Cuatro razones para confiar en cada entrega.</h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="card p-6">
          <span class="inline-flex w-12 h-12 rounded-xl items-center justify-center bg-[var(--color-lima-100)] text-[var(--color-bosque-700)]">
            <Icon name="leaf" size={26} />
          </span>
          <h3 class="mt-5 text-lg">100% Orgánico</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">
            Sin químicos sintéticos ni hormonas. Caballaza compostada y materias primas naturales — eso es todo.
          </p>
        </div>

        <div class="card p-6">
          <span class="inline-flex w-12 h-12 rounded-xl items-center justify-center bg-[var(--color-sol-100)] text-[var(--color-bosque-700)]">
            <Icon name="map-pin" size={26} />
          </span>
          <h3 class="mt-5 text-lg">Producción Panameña</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">
            Origen en Chiriquí, operaciones en Ciudad de Panamá. Materias primas de productores locales.
          </p>
        </div>

        <div class="card p-6">
          <span class="inline-flex w-12 h-12 rounded-xl items-center justify-center bg-[var(--color-naranja-100)] text-[var(--color-bosque-700)]">
            <Icon name="shield-check" size={26} />
          </span>
          <h3 class="mt-5 text-lg">Proyecto Completo</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">
            Tierra, abono, sustratos y plantas de vivero en una sola cotización y una sola entrega.
          </p>
        </div>

        <div class="card p-6">
          <span class="inline-flex w-12 h-12 rounded-xl items-center justify-center bg-[var(--color-bosque-50)] text-[var(--color-bosque-700)]">
            <Icon name="recycle" size={26} />
          </span>
          <h3 class="mt-5 text-lg">Agricultura Regenerativa</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">
            Mejora la salud del suelo, aumenta biodiversidad y contribuye al secuestro de carbono.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA FINAL / CONTACTO ============ -->
  <section class="py-16 sm:py-20">
    <div class="container-x">
      <div class="card p-8 sm:p-12 text-center bg-gradient-to-br from-[var(--color-crema)] to-white">
        <h2 class="text-3xl sm:text-4xl">Hablemos de tu suministro.</h2>
        <p class="mt-4 text-[var(--color-text-muted)] max-w-xl mx-auto leading-relaxed">
          Cuéntanos qué mueve tu operación — volquetes para la finca, pallets para exportar,
          producto empacado para tu anaquel o plantas para tu proyecto. Te respondemos por
          WhatsApp en horario laboral.
        </p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-primary">
            <Icon name="phone" size={18} />
            WhatsApp {site.phoneDisplay}
          </a>
          <a href={`mailto:${site.email}`} class="btn btn-outline">
            <Icon name="mail" size={18} />
            {site.email}
          </a>
        </div>
        <div class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-[var(--color-text-muted)]">
          <span class="inline-flex items-center gap-2">
            <Icon name="map-pin" size={16} class="text-[var(--color-bosque-700)]" />
            {site.address.street}, {site.address.city}
          </span>
          <a href={site.social.instagram} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-[var(--color-bosque-700)]">
            <Icon name="instagram" size={16} class="text-[var(--color-bosque-700)]" />
            Instagram {site.social.instagramHandle}
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
